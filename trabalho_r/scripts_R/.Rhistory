gdc_data <- file.path(base_dir, "GDCdata")
rna_seq_file <- file.path(base_dir, "mRNA_TCGA-LUAD.rda")
# Check if the data file already exists, if not, download and process
if (!file.exists(rna_seq_file)) {
query_LUAD <- GDCquery(
project = "TCGA-LUAD",
data.category = "Transcriptome Profiling",
data.type = "Gene Expression Quantification",
workflow.type = "STAR - Counts"
)
GDCdownload(query = query_LUAD, directory = gdc_data)
rna_seq_LUAD <- GDCprepare(
query = query_LUAD,
save = TRUE,
save.filename = rna_seq_file,
directory = gdc_data
)
rm(query_LUAD)
} else {
rna_seq_LUAD <- get(load(rna_seq_file))
rm(data)
}
# Extract gene expression matrix
geneExp <- SummarizedExperiment::assay(rna_seq_LUAD, "unstranded")
# Extract clinical metadata
metadata_col = SummarizedExperiment::colData(rna_seq_LUAD)
# Gene Annotations
metadata_row = SummarizedExperiment::rowData(rna_seq_LUAD)
rm(rna_seq_LUAD)
cat("Dimensions:", dim(geneExp)[1], "genes x", dim(geneExp)[2], "samples\n")
# Summaries
summary(geneExp[1:5, 1:5])
summary(metadata_col)
summary(metadata_row)
cat("Genes:", nrow(geneExp), "\n")
cat("Samples:", ncol(geneExp), "\n")
# Gene-wise statistics
gene_stats <- data.frame(
Mean = rowMeans(geneExp),
SD = apply(geneExp, 1, sd)
)
summary(gene_stats)
rm(gene_stats)
cat("Gene metadata:", dim(metadata_row), "\n")
cat("Sample metadata:", dim(metadata_col), "\n")
# For geneExp (gene expression matrix)
percent_missing_expression = colSums(is.na(geneExp)) / nrow(geneExp) * 100
# For metadata_col (clinical data)
percent_missing_clinical = colSums(is.na(metadata_col)) / nrow(metadata_col) * 100
cat("Unique % missing expression values per sample:", unique(percent_missing_expression), "\n")
df <- data.frame(variable = names(metadata_col),
missing = percent_missing_clinical)
ggplot(df, aes(x = reorder(variable, -missing), y = missing)) +
geom_segment(aes(xend = variable, yend = 0), color = "grey") +
geom_point(color = "tomato", size = 2) +
coord_flip() +
labs(title = "Missing Clinical Data per Variable",
x = "Variable", y = "% Missing") +
theme(axis.text.y = element_blank(),
axis.ticks.y = element_blank())
rm(df,percent_missing_expression)
data.frame(Variável = names(metadata_col),
Total_NAs = colSums(is.na(metadata_col)))
# Set the NA threshold
threshold = 30  # in percent
# For clinical data
clinical_data_filtered = metadata_col[, percent_missing_clinical <= threshold]
rm(percent_missing_clinical, threshold)
# GENDER
barplot(table(clinical_data_filtered$gender),
main = "Distribution of Gender",
xlab = "Gender",
ylab = "Count",
col = c("pink", "slategray1")[match(names(table(clinical_data_filtered@listData[["gender"]])), c("female", "male"))],
border = "white")
# RACE
race_table <- table(clinical_data_filtered$race)
race_percent <- prop.table(race_table) * 100
race_df <- data.frame(
Race = names(race_table),
Count = as.vector(race_table),
Percentage = round(as.vector(race_percent), 1)
)
print(race_df)
rm(race_table, race_percent, race_df)
# Keep only rows where race is white or black or african american
clinical_data_filtered <- clinical_data_filtered[
clinical_data_filtered@listData[["race"]] %in% c("white", "black or african american"),]
barplot(table(clinical_data_filtered@listData[["race"]]),
main = "Distribution of Race",
xlab = "Race",
ylab = "Count",
col = c("lightseagreen", "salmon"),
border = "white")
clinical_data_filtered$age_at_diagnosis <- clinical_data_filtered$age_at_diagnosis / 365.25
hist(clinical_data_filtered$age_at_diagnosis,
main = "Age at Diagnosis Distribution",
xlab = "Age",
col = "snow3",
breaks = 30,
border = "white")
diagnosis_data <- clinical_data_filtered$primary_diagnosis
diagnosis_table <- table(diagnosis_data)
diagnosis_percent <- sort(prop.table(diagnosis_table) * 100, decreasing = TRUE)
as.data.frame(diagnosis_percent)
# Keep only diagnoses with > 1% frequency
clinical_data_filtered <- clinical_data_filtered[
clinical_data_filtered$primary_diagnosis %in% names(diagnosis_percent[diagnosis_percent > 1]), ]
# Remove "Not Reported"
clinical_data_filtered <- clinical_data_filtered[
clinical_data_filtered$primary_diagnosis != "Not Reported", ]
table(clinical_data_filtered$primary_diagnosis)
rm(diagnosis_data, diagnosis_table, diagnosis_percent)
# Plot
# Example of a pie chart
pie(
table(clinical_data_filtered$primary_diagnosis),
main = "Primary Diagnosis",
col = c("#6A0572", "#9D0191", "#FF6464", "#FFAB73", "#FFC93C", "#F9F871"),
border = "white"
)
ggplot(clinical_data_filtered, aes(x = ajcc_pathologic_stage)) +
geom_bar(fill = "steelblue", color = "white") +
labs(
title = "Distribution of AJCC Pathologic Stages",
x = "AJCC Pathologic Stage",
y = "Count"
) +
theme_minimal()
barplot(table(clinical_data_filtered$tissue_type),
main = "Distribution of Tissue Type",
xlab = "Tissue Type",
ylab = "Count",
col = c("forestgreen", "darkred"),
border = "white")
barplot(table(clinical_data_filtered$vital_status),
main = "Distribution of Vital Status",
xlab = "Vital Status",
ylab = "Count",
col = c("plum", "plum4"),
border = "white")
sum(is.na(clinical_df$vital_status))
sum(is.na(clinical_df$tissue_status))
clinical_df$vital_status = factor(clinical_df$vital_status)
clinical_df$tissue_type = factor(clinical_df$tissue_type)
# Convert to base R data frame
clinical_df <- as.data.frame(clinical_data_filtered)
clinical_df <- clinical_df %>%
filter(
!is.na(age_at_diagnosis),
!is.na(primary_diagnosis),
!is.na(race),
!is.na(gender),
!is.na(vital_status),
!is.na(ajcc_pathologic_stage),
ajcc_pathologic_stage != "Stage I",
!is.na(tissue_type)
)
# Reverse the order of levels
clinical_df$vital_status <- factor(clinical_df$vital_status, levels = c("Dead", "Alive"))
# Calculate proportion of "Dead" per diagnosis
dead_prop <- clinical_df %>%
group_by(primary_diagnosis) %>%
summarize(prop_dead = mean(vital_status == "Dead", na.rm = TRUE)) %>%
arrange(desc(prop_dead))
# Reorder factor levels based on proportion
clinical_df$primary_diagnosis <- factor(clinical_df$primary_diagnosis,
levels = dead_prop$primary_diagnosis)
rm(dead_prop)
sum(is.na(clinical_df$vital_status))
sum(is.na(clinical_df$tissue_status))
clinical_df$vital_status = factor(clinical_df$vital_status)
clinical_df$tissue_type = factor(clinical_df$tissue_type)
#Removing from further analysis
clinical_df <- clinical_df %>%
filter(tissue_type != "Normal")
ADC_data <- geneExp[, rownames(clinical_df)]
set.seed(654321)
# Step 1: Compute CPM from raw counts (for filtering only)
cpm_raw <- cpm(ADC_data)
# Step 2: Filter out low-expressed genes
min_exp <- cpm_raw > 0.5
keep_genes <- rowSums(min_exp) >= 2
ADC_data_filt <- ADC_data[keep_genes, ]
# Step 3: Create DGEList object from filtered raw counts
dgeObj <- DGEList(ADC_data_filt)
# Step 4: Normalize (TMM) and transform for ML
dgeObj <- calcNormFactors(dgeObj)
log_geneExp_filt <- cpm(dgeObj, log = TRUE)
plot(density(as.vector(log_geneExp_filt)),
main = "Density of All log2-CPM Values",
xlab = "log2-CPM")
#Parameters
top_n_genes <- 300
train_frac <- 0.7
# Step 5: Load normalized matrix
rna_data <- data.frame(log_geneExp_filt)
# Step 6: Transpose so rows = samples, cols = genes
rna_data_t <- t(rna_data)
# Step 7: Remove zero-variance genes (on columns)
nzv <- nearZeroVar(rna_data_t, saveMetrics = TRUE)
non_zero_var_genes <- colnames(rna_data_t)[nzv$nzv == FALSE]
# Step 8: Now select DE genes from this subset
filtered_results_ord <- filtered_results$table[order(filtered_results$table$PValue), ]
filtered_results_ord <- filtered_results_ord[rownames(filtered_results_ord) %in% non_zero_var_genes, ]
top_genes <- rownames(head(filtered_results_ord, top_n_genes))
# To estimate common dispersion, trend dispersion and tag dispersion in a single run
dgeObj = estimateDisp(dgeObj, design = design)
fit = glmFit(dgeObj, design)
ddsSE = DESeqDataSetFromMatrix(countData = ADC_data, colData = clinical_df, design = ~vital_status)
ddsSE = ddsSE[rowSums(counts(ddsSE) >= 20) >= 4, ]
dim(ddsSE)
ddsSE_norm = DESeq(ddsSE)
res = results(ddsSE_norm, alpha = 0.05)
summary(res) # summary of differential expression test results
sum(res$padj < 0.05, na.rm=TRUE) # Total number of genes with differential expression
# Total number of tested genes
total_genes <- sum(!is.na(res$padj))
# Number of significantly differentially expressed genes (padj < 0.05)
sig_genes <- sum(res$padj < 0.05, na.rm = TRUE)
# Percentage of DE genes
percent_DE <- round((sig_genes / total_genes) * 100, 2)
# Among DE genes, count upregulated and downregulated
upregulated <- sum(res$padj < 0.05 & res$log2FoldChange > 0, na.rm = TRUE)
downregulated <- sum(res$padj < 0.05 & res$log2FoldChange < 0, na.rm = TRUE)
# Normalization of count data
ADC_data_CPM <- cpm(ADC_data)
ADC_data_CPM_log <- cpm(ADC_data, log = TRUE)
dim(ADC_data_CPM)
# Removal of genes that do not have an expression of 0.5 or higher in at least 2 samples
min_exp = ADC_data_CPM > 0.5
keep_rows =  rowSums(min_exp) >= 2
ADC_data_CPM_filt = ADC_data_CPM[keep_rows,]
dim(ADC_data_CPM_filt)
# Transformation of standardized counts
dgeObj = DGEList(ADC_data_CPM_filt)
log_geneExp_filt = cpm(dgeObj, log=TRUE)
boxplot(log_geneExp_filt[,1:100], xlab="", ylab="Log2 counts per million",las=2)
abline(h=median(log_geneExp_filt),col="deeppink")
title("Boxplots of logCPMs (not normalized)")
# To estimate common dispersion, trend dispersion and tag dispersion in a single run
dgeObj = estimateDisp(dgeObj, design = design)
fit = glmFit(dgeObj, design)
# Transformation of standardized counts
dgeObj = DGEList(ADC_data_CPM_filt)
log_geneExp_filt = cpm(dgeObj, log=TRUE)
boxplot(log_geneExp_filt[,1:100], xlab="", ylab="Log2 counts per million",las=2)
abline(h=median(log_geneExp_filt),col="deeppink")
title("Boxplots of logCPMs (not normalized)")
# Normalization of the library size of each sample
dgeObj = calcNormFactors(dgeObj)
# Differential expression analysis
vital_status = as.factor(clinical_df$vital_status)
design = model.matrix(~vital_status)
# To estimate common dispersion, trend dispersion and tag dispersion in a single run
dgeObj = estimateDisp(dgeObj, design = design)
fit = glmFit(dgeObj, design)
lrt = glmLRT(fit, coef=2)
topTags(lrt)
# glmTreat is used to filter the DE genes and focus only on the genes that are most biologically significant
# filter out the differentially expressed genes with the greatest biological importance
filtered_results = glmTreat(fit, lfc=log2(1.5))
topTags(filtered_results)
summary(decideTests(filtered_results))
plotMD(filtered_results)
abline(h=c(-1, 1), col="burlywood2")
set.seed(654321)
# Step 1: Compute CPM from raw counts (for filtering only)
cpm_raw <- cpm(ADC_data)
# Step 2: Filter out low-expressed genes
min_exp <- cpm_raw > 0.5
keep_genes <- rowSums(min_exp) >= 2
ADC_data_filt <- ADC_data[keep_genes, ]
# Step 3: Create DGEList object from filtered raw counts
dgeObj <- DGEList(ADC_data_filt)
# Step 4: Normalize (TMM) and transform for ML
dgeObj <- calcNormFactors(dgeObj)
log_geneExp_filt <- cpm(dgeObj, log = TRUE)
plot(density(as.vector(log_geneExp_filt)),
main = "Density of All log2-CPM Values",
xlab = "log2-CPM")
#Parameters
top_n_genes <- 300
train_frac <- 0.7
# Step 5: Load normalized matrix
rna_data <- data.frame(log_geneExp_filt)
# Step 6: Transpose so rows = samples, cols = genes
rna_data_t <- t(rna_data)
# Step 7: Remove zero-variance genes (on columns)
nzv <- nearZeroVar(rna_data_t, saveMetrics = TRUE)
non_zero_var_genes <- colnames(rna_data_t)[nzv$nzv == FALSE]
# Step 8: Now select DE genes from this subset
filtered_results_ord <- filtered_results$table[order(filtered_results$table$PValue), ]
filtered_results_ord <- filtered_results_ord[rownames(filtered_results_ord) %in% non_zero_var_genes, ]
top_genes <- rownames(head(filtered_results_ord, top_n_genes))
# Step 9: Build final expression matrix (samples x genes)
expr_mat <- rna_data_t[, top_genes, drop = FALSE]
# Step 10: Combine with clinical labels
rna_data_vital_status <- data.frame(
vital = factor(clinical_df$vital_status),
expr_mat
)
# Step 11: Clean and split
levels(rna_data_vital_status$vital) <- make.names(levels(rna_data_vital_status$vital))
stopifnot(!any(is.na(rna_data_vital_status)))
train_idx <- createDataPartition(rna_data_vital_status$vital, p = train_frac, list = FALSE)
train_set <- rna_data_vital_status[train_idx, ]
test_set <- rna_data_vital_status[-train_idx, ]
# Report
cat("Training set dimensions:", dim(train_set), "\n")
cat("Test set dimensions:", dim(test_set), "\n")
cat("- Full dataset:\n")
print(prop.table(table(rna_data_vital_status$vital)))
cat("- Training set:\n")
print(prop.table(table(train_set$vital)))
cat("- Test set:\n")
print(prop.table(table(test_set$vital)))
# Create 10 cross-validation folds, stratified by class
folds <- createFolds(train_set$vital, k = 10, list = TRUE)
# Set up training control with correct fold indices
cv_control <- trainControl(
method = "cv",
number = 10,
index = folds,
savePredictions = "final",
classProbs = TRUE,
summaryFunction = twoClassSummary,  # Add if doing binary classification
verboseIter = TRUE,  # Recommended to see progress
sampling = "smote"
)
# List of models to compare with tuning parameters
models <- list(
rf = list(method = "rf", tuneLength = 5),
svmRadial = list(method = "svmRadial", tuneLength = 5),
glm = list(method = "glm"),
glmnet = list(method = "glmnet", tuneLength = 5),
knn = list(method = "knn", tuneLength = 10)
)
# Store results
model_list <- list()
# Train each model
for (m in names(models)) {
cat("Training:", m, "\n")
if (m == "svmRadial") {
# formula interface to avoid probability prediction bug
model_list[[m]] <- train(
vital ~ .,
data = train_set,
method = models[[m]]$method,
trControl = cv_control,
preProcess = c("center", "scale"),
tuneLength = models[[m]]$tuneLength,
metric = "ROC"
)
} else {
args <- list(
x = train_set[, -which(names(train_set) == "vital")],
y = train_set$vital,
method = models[[m]]$method,
trControl = cv_control,
preProcess = c("center", "scale")
)
# Add model-specific arguments
if (!is.null(models[[m]]$tuneLength)) {
args$tuneLength <- models[[m]]$tuneLength
}
if (m == "glm") {
args$family <- binomial()
}
model_list[[m]] <- do.call(train, args)
}
}
select_best_model <- function(models, test_data, positive_class = "Alive") {
# Verify test_data has the required column
if (!"vital" %in% colnames(test_data)) {
stop("test_data must contain a 'vital' column")
}
results <- lapply(names(models), function(model_name) {
model <- models[[model_name]]
# Initialize all metrics as NA
metrics <- c(
TrainROC = NA,
TestAUC = NA,
Accuracy = NA,
Sensitivity = NA,
Specificity = NA,
BalancedAcc = NA
)
tryCatch({
# Training ROC
if ("ROC" %in% colnames(model$results)) {
metrics["TrainROC"] <- max(model$results$ROC, na.rm = TRUE)
}
# Predictions
pred <- predict(model, newdata = test_data)
prob <- predict(model, newdata = test_data, type = "prob")[, positive_class]
# Ensure predictions have same levels as test data
pred_factor <- factor(pred, levels = levels(test_data$vital))
# Confusion Matrix
cm <- confusionMatrix(pred_factor, test_data$vital, positive = positive_class)
# AUC calculation
if (length(unique(test_data$vital)) == 2) {
roc_obj <- roc(response = test_data$vital, predictor = prob,
levels = rev(levels(test_data$vital)))
metrics["TestAUC"] <- as.numeric(auc(roc_obj))
}
# Extract metrics
metrics["Accuracy"] <- cm$overall["Accuracy"]
metrics["Sensitivity"] <- cm$byClass["Sensitivity"]
metrics["Specificity"] <- cm$byClass["Specificity"]
metrics["BalancedAcc"] <- cm$byClass["Balanced Accuracy"]
}, error = function(e) {
warning(paste("Error evaluating model", model_name, ":", e$message))
})
return(metrics)
})
# Name the results
names(results) <- names(models)
# Convert to data frame
metrics_df <- as.data.frame(do.call(rbind, results))
# Calculate composite score using available metrics
valid_metrics <- c("TestAUC", "BalancedAcc", "Accuracy", "Sensitivity", "Specificity")
metrics_to_use <- intersect(valid_metrics, colnames(metrics_df))
# Normalize metrics to 0-1 range if needed
for (m in metrics_to_use) {
if (any(metrics_df[[m]] > 1, na.rm = TRUE)) {
metrics_df[[m]] <- metrics_df[[m]] / 100
}
}
# Calculate composite score (average of available metrics)
metrics_df$Composite <- rowMeans(metrics_df[, metrics_to_use, drop = FALSE], na.rm = TRUE)
# Get best model
if (all(is.na(metrics_df$Composite))) {
stop("No valid models could be evaluated")
}
best_name <- rownames(metrics_df)[which.max(metrics_df$Composite)]
list(
best_model_name = best_name,
best_model = models[[best_name]],
metrics_table = metrics_df[order(-metrics_df$Composite), ]
)
}
# Compare models
resamps <- resamples(model_list)
# Summary metrics
summary(resamps)
# Run after training models and splitting test_set
model_eval <- select_best_model(model_list, test_set)
cat("Best model is:", model_eval$best_model_name, "\n")
print(model_eval$metrics_table)
# Evaluate on test set
test_pred <- predict(model_eval$best_model, newdata = test_set)  # Consistent naming
conf_mat <- confusionMatrix(test_pred, test_set$vital, positive = levels(test_set$vital)[2])
print(conf_mat)
# ROC analysis
if (nlevels(test_set$vital) == 2) {  # Only for binary classification
# Compute ROC objects for each model
roc_rf     <- roc(test_set$vital, predict(model_list$rf,       newdata = test_set, type = "prob")[, 2])
roc_glmnet <- roc(test_set$vital, predict(model_list$glmnet,   newdata = test_set, type = "prob")[, 2])
roc_knn    <- roc(test_set$vital, predict(model_list$knn,      newdata = test_set, type = "prob")[, 2])
roc_svm    <- roc(test_set$vital, predict(model_list$svmRadial,newdata = test_set, type = "prob")[, 2])
roc_glm    <- roc(test_set$vital, predict(model_list$glm,      newdata = test_set, type = "prob")[, 2])
# Plot the first model (RF)
plot(roc_rf, col = "forestgreen", lwd = 2, main = "ROC Curves: RF, GLMNET, kNN, SVM")
# Add other ROC lines
lines(roc_glmnet, col = "blue",       lwd = 2)
lines(roc_knn,    col = "darkorange", lwd = 2)
lines(roc_svm,    col = "purple",     lwd = 2)
lines(roc_glm,    col = "red",     lwd = 2)
# Add legend
legend("bottomright", legend = c(
paste("RF        AUC =", round(auc(roc_rf),     3)),
paste("GLMNET    AUC =", round(auc(roc_glmnet), 3)),
paste("kNN       AUC =", round(auc(roc_knn),    3)),
paste("SVM       AUC =", round(auc(roc_svm),    3)),
paste("GLM      AUC =", round(auc(roc_glm),    3))
),
col = c("forestgreen", "blue", "darkorange", "purple", "red"),
lwd = 2)
}
# Get Composite scores from model_eval table
comp_scores <- model_eval$metrics_table$Composite
names(comp_scores) <- rownames(model_eval$metrics_table)
# Normalize to get weights that sum to 1
weights <- comp_scores[c("svmRadial", "rf", "glmnet", "knn")]
weights <- weights / sum(weights)
print(weights)  # Optional: inspect weights
# ---- WEIGHTED SOFT VOTING ----
positive_class <- levels(test_set$vital)[2]
# Get predicted probabilities
probs <- data.frame(
svmRadial = predict(model_list$svmRadial, newdata = test_set, type = "prob")[, positive_class],
rf        = predict(model_list$rf,        newdata = test_set, type = "prob")[, positive_class],
glmnet    = predict(model_list$glmnet,    newdata = test_set, type = "prob")[, positive_class],
knn       = predict(model_list$knn,       newdata = test_set, type = "prob")[, positive_class]
)
# Ensure same order of weights as columns
probs <- probs[, names(weights)]
# Weighted average
soft_vote_prob <- as.numeric(as.matrix(probs) %*% weights)
# Final prediction
soft_vote_pred <- factor(
ifelse(soft_vote_prob >= 0.5, positive_class, levels(test_set$vital)[1]),
levels = levels(test_set$vital)
)
# Evaluate
conf_mat_soft <- confusionMatrix(soft_vote_pred, test_set$vital, positive = positive_class)
print(conf_mat_soft)
roc_soft <- roc(test_set$vital, soft_vote_prob)
plot(roc_soft, main = "Weighted Soft Voting ROC", col = "darkred", lwd = 2, print.auc = TRUE)
cat("Weighted Soft Voting AUC:", round(auc(roc_soft), 3), "\n")
View(rna_data)
