clinical_df <- as.data.frame(clinical_data_filtered)
clinical_df <- clinical_df %>%
filter(
!is.na(age_at_diagnosis),
!is.na(primary_diagnosis),
!is.na(race),
!is.na(gender),
!is.na(vital_status),
!is.na(ajcc_pathologic_stage),
ajcc_pathologic_stage != "Stage I"
)
# Reverse the order of levels
clinical_df$vital_status <- factor(clinical_df$vital_status, levels = c("Dead", "Alive"))
# Calculate proportion of "Dead" per diagnosis
dead_prop <- clinical_df %>%
group_by(primary_diagnosis) %>%
summarize(prop_dead = mean(vital_status == "Dead", na.rm = TRUE)) %>%
arrange(desc(prop_dead))
# Reorder factor levels based on proportion
clinical_df$primary_diagnosis <- factor(clinical_df$primary_diagnosis,
levels = dead_prop$primary_diagnosis)
# Plot
ggplot(clinical_df, aes(x = primary_diagnosis, fill = vital_status)) +
geom_bar(position = "fill") +
geom_text(stat = "count", aes(label = after_stat(count)),
position = position_fill(vjust = 0.5), size = 3) +
labs(title = "Vital Status by Primary Diagnosis", y = "Proportion") +
theme(axis.text.x = element_text(angle = 90, hjust = 1))
chisq.test(table(clinical_df$vital_status, clinical_df$primary_diagnosis))
fisher.test(table(clinical_df$vital_status, clinical_df$primary_diagnosis), simulate.p.value = TRUE)
# Plot
ggplot(clinical_df, aes(x = gender, fill = vital_status)) +
geom_bar(position = "fill") +
geom_text(stat = "count", aes(label = ..count..), position = position_fill(vjust = 0.5), size = 3) +
labs(title = "Vital Status by Gender", y = "Proportion") +
theme(axis.text.x = element_text(angle = 45, hjust = 1))
chisq.test(table(clinical_df$vital_status, clinical_df$gender))
# Plot
ggplot(clinical_df, aes(x = race, fill = vital_status)) +
geom_bar(position = "fill") +
geom_text(stat = "count", aes(label = ..count..), position = position_fill(vjust = 0.5), size = 3) +
labs(title = "Vital Status by Race", y = "Proportion") +
theme(axis.text.x = element_text(angle = 45, hjust = 1))
chisq.test(table(clinical_df$vital_status, clinical_df$race))
# Plot
ggplot(clinical_df, aes(x = ajcc_pathologic_stage, fill = vital_status)) +
geom_bar(position = "fill") +
geom_text(stat = "count", aes(label = ..count..), position = position_fill(vjust = 0.5), size = 3) +
labs(title = "Vital Status by AJCC Pathologic Stage", y = "Proportion") +
theme(axis.text.x = element_text(angle = 45, hjust = 1))
chisq.test(table(clinical_df$vital_status, clinical_df$ajcc_pathologic_stage))
fisher.test(table(clinical_df$vital_status, clinical_df$ajcc_pathologic_stage), simulate.p.value = TRUE)
ggplot(clinical_df, aes(x = vital_status, y = age_at_diagnosis , fill = vital_status)) +
geom_boxplot(outlier.shape = 21, outlier.fill = "white") +
labs(
title = "Age at Diagnosis by Vital Status",
x = "Vital Status",
y = "Age at Diagnosis (years)"
) +
theme_minimal() +
theme(legend.position = "none")  # optional: remove redundant legend
# Shapiro-Wilk test for normality in each group
shapiro.test(clinical_df$age_at_diagnosis[clinical_df$vital_status == "Alive"])
shapiro.test(clinical_df$age_at_diagnosis[clinical_df$vital_status == "Dead"])
qqnorm(clinical_df$age_at_diagnosis[clinical_df$vital_status == "Alive"])
qqline(clinical_df$age_at_diagnosis[clinical_df$vital_status == "Alive"])
qqnorm(clinical_df$age_at_diagnosis[clinical_df$vital_status == "Dead"])
qqline(clinical_df$age_at_diagnosis[clinical_df$vital_status == "Dead"])
wilcox.test(age_at_diagnosis ~ vital_status, data = clinical_df)
clinical_df
diagnosis_table
filtered_diagnosis = clinical_df[clinical_df == "Adenocarcinoma, NOS"]
data_ADC = expression_data[,rownames((filtered_diagnosis))]
dim(data_ADC)
metadata_col = SummarizedExperiment::colData(rna_seq_LUAD)
geneExp = SummarizedExperiment::assay(rna_seq_LUAD, "unstranded")
filtered_data = metadata_col[!is.na(metadata_col$primary_diagnosis),]
filtered_data = filtered_data[filtered_data$primary_diagnosis=="Adenocarcinoma, NOS",]
ADC_data = geneExp[,rownames(filtered_data)]
dim(ADC_data)
sum(is.na(filtered_data$vital_status))
filtered_data$vital_status = factor(filtered_data$vital_status)
ddsSE = DESeqDataSetFromMatrix(countData = ADC_data, colData = filtered_data, design = ~vital_status)
# filtragem de genes com menos de 20 ocorrências em pelo menos 4 amostras
keep_genes = rowSums(counts(ddsSE) >= 20) >= 4
ddsSE = ddsSE[keep_genes, ]
dim(ddsSE)
ddsSE_norm = DESeq(ddsSE)
res = results(ddsSE_norm, alpha = 0.05)
summary(res) # summary of differential expression test results
sum(res$padj < 0.05, na.rm=TRUE) # Total number of genes with differential expression
de_gene_count <- sum(res$padj < 0.05, na.rm = TRUE)
print(de_gene_count)
# Total number of tested genes
total_genes <- sum(!is.na(res$padj))
# Number of significantly differentially expressed genes (padj < 0.05)
sig_genes <- sum(res$padj < 0.05, na.rm = TRUE)
# Percentage of DE genes
percent_DE <- round((sig_genes / total_genes) * 100, 2)
# Among DE genes, count upregulated and downregulated
upregulated <- sum(res$padj < 0.05 & res$log2FoldChange > 0, na.rm = TRUE)
downregulated <- sum(res$padj < 0.05 & res$log2FoldChange < 0, na.rm = TRUE)
# Print results
cat("Total tested genes:", total_genes, "\n")
cat("Significantly DE genes:", sig_genes, "(", percent_DE, "% )\n")
cat("Upregulated:", upregulated, "\n")
cat("Downregulated:", downregulated, "\n")
#  graphical display of results
DESeq2::plotMA(res, main="DESeq2 differential expression analysis")
plotCounts(ddsSE_norm, gene=which.min(res$padj), intgroup="vital_status", pch = 19)
plotCounts(ddsSE_norm, gene=which.min(res$padj), intgroup="vital_status", pch = 19)
resOrdered = res[order(res$padj),]
resOrdered[1,]
# Normalization of count data
ADC_data_CPM = cpm(ADC_data)
dim(ADC_data_CPM)
# Removal of genes that do not have an expression of 0.5 or higher in at least 2 samples
min_exp = ADC_data_CPM > 0.5
keep_rows =  rowSums(min_exp) >= 2
ADC_data_CPM_filt = ADC_data_CPM[keep_rows,]
dim(ADC_data_CPM_filt)
# Transformation of standardized counts
dgeObj = DGEList(ADC_data_CPM_filt)
log_geneExp_filt = cpm(dgeObj, log=TRUE)
boxplot(log_geneExp_filt[,1:100], xlab="", ylab="Log2 counts per million",las=2)
abline(h=median(log_geneExp_filt),col="deeppink")
title("Boxplots of logCPMs (not normalized)")
# Normalization of the library size of each sample
dgeObj = calcNormFactors(dgeObj)
# Differential expression analysis
vital_status = as.factor(filtered_data$vital_status)
design = model.matrix(~vital_status)
# To estimate common dispersion, trend dispersion and tag dispersion in a single run
dgeObj = estimateDisp(dgeObj, design = design)
fit = glmFit(dgeObj, design)
lrt = glmLRT(fit, coef=2)
topTags(lrt)
#Genes information (underexpressed (down), not significant(NotSig), overexpressed(Up))
summary(decideTests(lrt))
# Graphic visualization of differentially expressed genes
plotMD(lrt)
abline(h=c(-1, 1), col="burlywood2")
# glmTreat is used to filter the DE genes and focus only on the genes that are most biologically significant
# filter out the differentially expressed genes with the greatest biological importance
filtered_results = glmTreat(fit, lfc=log2(1.5))
topTags(filtered_results)
summary(decideTests(filtered_results))
plotMD(filtered_results)
abline(h=c(-1, 1), col="burlywood2")
vital_status = as.factor(filtered_data$vital_status)
design = model.matrix(~vital_status)
dgeObj = estimateDisp(dgeObj, design = design)
fit = glmFit(dgeObj, design)
lrt = glmLRT(fit, coef=2)
topTags(lrt)
# Genes information (under-expressed, not significant, over-expressed)
summary(decideTests(lrt))
# Graphic visualization of differentially expressed genes
plotMD(lrt)
abline(h=c(-1, 1), col="lightpink4")
# glmTreat é usado para filtrar os genes DE e focar apenas nos genes que são mais biologicamente significativos
# filtrar os genes diferencialmente expressos com maior importância biológica
filtered_results = glmTreat(fit, lfc=log2(1.5))
topTags(filtered_results)
summary(decideTests(filtered_results))
plotMD(filtered_results)
abline(h=c(-1, 1), col="lightpink4")
# Differential expression analysis of the most commonly mutated genes
mutant_genes = c("ENSG00000138379.5", "ENSG00000122585.8", "ENSG00000122711.9", "ENSG00000204941.14","ENSG00000130055.14", "ENSG00000261742.6", "ENSG00000185269.12", "ENSG00000243137.8","ENSG00000162494.6", "ENSG00000145692.15")
n_gene_edgeR=c()
for (gene in mutant_genes){
n_gene_edgeR=c(n_gene_edgeR, which(rownames(filtered_results)==gene))
}
filtered_results[n_gene_edgeR,]$table
n_gene_DESeq2=c()
for (gene in mutant_genes){
n_gene_DESeq2=c(n_gene_DESeq2, which(rownames(res)==gene))
}
res[n_gene_DESeq2,]
filtered_res <- res[n_gene_DESeq2, ]
filtered_res <- filtered_res[filtered_res$padj < 0.05, ]
filtered_res
# Analysis of the study genes signaled as differentially expressed
plotCounts(ddsSE_norm, gene=which(rownames(res)=="ENSG00000122711.9"), intgroup="vital_status", pch = 19)
plotCounts(ddsSE_norm, gene=which(rownames(res)=="ENSG00000130055.14"), intgroup="vital_status", pch = 19)
plotCounts(ddsSE_norm, gene=which(rownames(res)=="ENSG00000185269.12"), intgroup="vital_status", pch = 19)
plotCounts(ddsSE_norm, gene=which(rownames(res)=="ENSG00000145692.15"), intgroup="vital_status", pch = 19)
# Each gene name
gene_name=c()
for (gene in rownames(res)) {
gene_name =c(gene_name,
gene_metadata[gene,"gene_name"])
}
# Adding the name of each gene to the dataframe of the differential expression results
res["gene_name"] = gene_name
# save the data frame results
write.csv(res, file = "dge_deseq2.csv", row.names = T)
# Loading the group of genes for enrichment analysis
c6_dir <- file.path(base_dir, "c6.all.v2023.2.Hs.symbols.gmt")
path = gmtPathways(c6_dir)
# Sort the results by expression change in descending order
results_ord = res[order(-res[,"log2FoldChange"]), ]
# Prepares the rankings for FGSEA
ranks = results_ord$log2FoldChange
# Associates the name of the gene to the lines
names(ranks) = results_ord$gene_name
# Sorts the results by the change in expression in descending order
results_ord = res[order(-res[,"log2FoldChange"]), ]
# Identificar genes duplicados
duplicated_genes = names(ranks)[duplicated(names(ranks))]
# Remover genes duplicados
ranks = ranks[!names(ranks) %in% duplicated_genes]
# Executar a análise FGSEA com os genes não duplicados
fgseaRes = fgsea(pathways = path, stats = ranks, minSize = 15, maxSize = 500, nproc=1)
# número de vias enriquecidas
sum(fgseaRes[, padj<0.01])
res_ord = fgseaRes[order(padj),]
res_ord[res_ord[, padj<0.01]]
#salvar o resultado da análise de enriquecimento ordenado
write.csv(as.data.frame(res_ord[,1:6]), file = "enrichemnt_analysiss.csv", row.names = T)
# leitura dos resultados da análise de enriquecimento
enrichment = enrichemnt_analysiss <- read.csv("enrichemnt_analysiss.csv", row.names=1)
# através do ficheiro csv número de vias enriquecidas
sum(enrichment$padj<0.01)
head(enrichment)
